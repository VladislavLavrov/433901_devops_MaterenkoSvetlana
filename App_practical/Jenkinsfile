pipeline {
    agent any
    stages {
        stage('Hello') {
            steps {
                echo 'Hello jenkins'
            }
        }
        stage('Build Docker Image') {
            steps {
                sh 'cd App_practical && ls -l'
                sh 'cd App_practical && docker compose build'
            }
        }
        stage('Start Docker Container') {
            steps {
                sh 'cd App_practical && docker compose up -d'
            }
        }
    }
}